---
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-top">
      <a href="#" class="logo">
        <img src="/logo-branco.png" alt="SEGURAMENT" class="footer-logo-img" />
      </a>
    </div>

    <hr class="footer-divider" />

    <div class="footer-bottom">
      <p class="copyright">© 2026 SEGURAMENT. Todos os direitos reservados.</p>
      <div class="footer-links">
        <a href="#" class="footer-link">Termos de Uso</a>
        <a href="#" class="footer-link">Política de Privacidade</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #0f172a;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 60px 0 40px 0;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .footer-logo-img {
    height: 52px;
    width: auto;
    object-fit: contain;
    transition: transform var(--transition-base);
  }

  .logo:hover .footer-logo-img {
    transform: scale(1.03);
  }

  .footer-divider {
    width: 100%;
    height: 1px;
    border: none;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    margin-bottom: 30px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .footer-links {
    display: flex;
    gap: 24px;
  }

  .footer-link {
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }
  }
</style>
