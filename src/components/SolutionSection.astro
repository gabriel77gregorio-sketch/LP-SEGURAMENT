---
---

<section id="solucao" class="section solution-section">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-label">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
        A Solução
      </div>
      <h2 class="section-title">
        Metodologia validada para <br />
        <span class="highlight">eliminar o risco legal.</span>
      </h2>
      <p class="section-subtitle">
        O SEGURAMENT não é um questionário isolado. É uma engrenagem técnica completa projetada para consolidar, comprovar e blindar juridicamente a gestão de saúde mental da assessoria e de seus clientes.
      </p>
    </div>

    <!-- Alternating Features List -->
    <div class="features-zigzag">
      <!-- Feature 1 -->
      <div class="zigzag-row reveal-left">
        <div class="feature-text">
          <span class="feature-num">01</span>
          <h3 class="feature-title">Integração Obrigatória (AEP e PGR)</h3>
          <p class="feature-desc">
            O Ministério do Trabalho exige que os resultados das avaliações de riscos psicossociais sejam integrados diretamente ao Inventário de Riscos e à Avaliação Ergonômica Preliminar (AEP). O SEGURAMENT automatiza esta consolidação em segundos.
          </p>
          <div class="compliance-badge">
            <span class="badge-icon">✓</span>
            Conformidade Técnica Garantida
          </div>
        </div>
        <div class="feature-image">
          <!-- System Image Slot 1 -->
          <div class="system-screenshot">
            <div class="placeholder-content">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
              <span class="placeholder-tag">[IMAGEM DO SISTEMA — INTEGRAÇÃO AEP / PGR]</span>
              <span class="placeholder-sub">Mapeamento de riscos e exportação automática para o PGR</span>
            </div>
            <!-- Para colocar imagem real depois: <img src="/caminho-da-imagem.png" alt="Integração AEP/PGR" /> -->
          </div>
        </div>
      </div>

      <!-- Feature 2 -->
      <div class="zigzag-row reverse reveal-right">
        <div class="feature-text">
          <span class="feature-num">02</span>
          <h3 class="feature-title">Documentação à Prova de Fiscalização</h3>
          <p class="feature-desc">
            Evite a aplicação de autos de infração. Nosso motor gera automaticamente o inventário de riscos psicossociais detalhado e o plano de ação correspondente exigido pelo GRO, com total coerência entre perigo, lesão e medidas preventivas.
          </p>
          <div class="compliance-badge">
            <span class="badge-icon">✓</span>
            Relatórios Auditáveis MTE
          </div>
        </div>
        <div class="feature-image">
          <!-- System Image Slot 2 -->
          <div class="system-screenshot">
            <div class="placeholder-content">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
              <span class="placeholder-tag">[IMAGEM DO SISTEMA — GERADOR DE LAUDOS]</span>
              <span class="placeholder-sub">Inventário de Riscos e Planos de Ação em 1 clique</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 3 -->
      <div class="zigzag-row reveal-left">
        <div class="feature-text">
          <span class="feature-num">03</span>
          <h3 class="feature-title">Evidência Incontestável de Participação</h3>
          <p class="feature-desc">
            A fiscalização exige prova documental de que os colaboradores participaram ativamente da identificação de perigos. O SEGURAMENT gera e guarda evidências digitais de escuta ativa e envolvimento real de forma simples e segura.
          </p>
          <div class="compliance-badge">
            <span class="badge-icon">✓</span>
            Garantia de Escuta Ativa
          </div>
        </div>
        <div class="feature-image">
          <!-- System Image Slot 3 -->
          <div class="system-screenshot">
            <div class="placeholder-content">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
              <span class="placeholder-tag">[IMAGEM DO SISTEMA — PORTAL DE ESCUTA]</span>
              <span class="placeholder-sub">Painel de escuta ativa e engajamento seguro</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 4 -->
      <div class="zigzag-row reverse reveal-right">
        <div class="feature-text">
          <span class="feature-num">04</span>
          <h3 class="feature-title">Consultoria Estratégica, Não Apenas Software</h3>
          <p class="feature-desc">
            A ferramenta faz o processamento dos dados brutos sobre esgotamento mental e clima organizacional, permitindo que seus especialistas dediquem tempo ao que realmente importa: direcionamento clínico e técnico de alto nível.
          </p>
          <div class="compliance-badge">
            <span class="badge-icon">✓</span>
            Inteligência de Retaguarda
          </div>
        </div>
        <div class="feature-image">
          <!-- System Image Slot 4 -->
          <div class="system-screenshot">
            <div class="placeholder-content">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <!-- Brain with cogwheels SVG outline -->
                <path d="M9.5 9.5 C8 7 11 5 13 6.5 C15 5 18.5 7 17 9.5 C19 11 19 14 17 15.5 C18.5 18 15 20 13 18.5 C11 20 8 18 9.5 15.5 C7.5 14 7.5 11 9.5 9.5 Z"/>
                <circle cx="13.5" cy="12.5" r="2.5" />
              </svg>
              <span class="placeholder-tag">[IMAGEM DO SISTEMA — DASHBOARD ANALÍTICO]</span>
              <span class="placeholder-sub">Indicadores de esgotamento e saúde mental integrados</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="blue-glow-orb"></div>
</section>

<style>
  .solution-section {
    background-color: var(--bg-alt);
    border-top: 1px solid var(--border-light);
    position: relative;
  }

  .section-header {
    margin-bottom: 80px;
  }

  .features-zigzag {
    display: flex;
    flex-direction: column;
    gap: 120px;
  }

  .zigzag-row {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 80px;
    align-items: center;
  }

  .zigzag-row.reverse {
    grid-template-columns: 1.1fr 1fr;
  }

  .zigzag-row.reverse .feature-text {
    grid-column: 2;
  }

  .zigzag-row.reverse .feature-image {
    grid-column: 1;
    grid-row: 1;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .feature-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--blue-bright);
    margin-bottom: 12px;
  }

  .feature-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 20px;
    color: var(--text-main);
  }

  .feature-desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .compliance-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: var(--radius-full);
    padding: 6px 14px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--success);
  }

  .badge-icon {
    font-weight: 900;
  }

  .feature-image {
    position: relative;
  }

  /* Screenshot styles overwrites */
  .system-screenshot {
    border-color: var(--border-light);
    background-color: var(--bg-card);
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
    box-shadow: var(--shadow-md);
  }

  .system-screenshot:hover {
    border-color: var(--blue-bright);
    transform: scale(1.02);
    box-shadow: var(--shadow-lg), 0 0 25px rgba(0, 74, 173, 0.1);
  }

  .placeholder-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 14px;
    color: var(--text-dim);
    padding: 30px;
    text-align: center;
  }

  .placeholder-tag {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: 0.05em;
  }

  .placeholder-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .blue-glow-orb {
    position: absolute;
    top: 40%;
    right: -10%;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background-color: rgba(0, 74, 173, 0.05);
    filter: blur(120px);
    z-index: 1;
    pointer-events: none;
  }

  @media (max-width: 991px) {
    .zigzag-row, .zigzag-row.reverse {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .zigzag-row.reverse .feature-text {
      grid-column: 1;
    }

    .zigzag-row.reverse .feature-image {
      grid-column: 1;
      grid-row: auto;
    }

    .features-zigzag {
      gap: 80px;
    }
  }
</style>
