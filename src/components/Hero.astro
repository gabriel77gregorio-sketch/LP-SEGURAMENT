<section class="hero-section">
  <!-- Ticker de Urgência -->
  <div class="ticker-wrap">
    <div class="ticker">
      <div class="ticker-item">⚠️ A NOVA NR-1 ENTRA EM VIGOR EM 26 DE MAIO DE 2026</div>
      <div class="ticker-item">⚠️ RISCOS PSICOSSOCIAIS SÃO OBRIGATÓRIOS</div>
      <div class="ticker-item">⚠️ MULTAS PREVISTAS NO ART. 201 DA CLT</div>
      <div class="ticker-item">⚠️ OMISSÃO NO PGR GERA FISCALIZAÇÃO E INFRAÇÃO</div>
      <!-- Duplicate for infinite marquee -->
      <div class="ticker-item">⚠️ A NOVA NR-1 ENTRA EM VIGOR EM 26 DE MAIO DE 2026</div>
      <div class="ticker-item">⚠️ RISCOS PSICOSSOCIAIS SÃO OBRIGATÓRIOS</div>
      <div class="ticker-item">⚠️ MULTAS PREVISTAS NO ART. 201 DA CLT</div>
      <div class="ticker-item">⚠️ OMISSÃO NO PGR GERA FISCALIZAÇÃO E INFRAÇÃO</div>
    </div>
  </div>

  <div class="container hero-container">
    <div class="hero-content reveal">
      <div class="urgency-badge">
        <span class="pulse-dot"></span>
        <span>Prazo Final: 26 de Maio de 2026</span>
      </div>
      
      <h1 class="hero-title">
        Sua clínica de SST ainda trata risco psicossocial como <span class="strike-through">opcional</span>?
        <span class="hero-highlight">O MTE discorda.</span>
      </h1>
      
      <p class="hero-description">
        Omissão na avaliação de riscos psicossociais agora gera autuações pesadas e processos trabalhistas. O <strong>SEGURAMENT</strong> é a retaguarda técnica em compliance que blinda seus clientes e garante conformidade total.
      </p>

      <div class="hero-actions">
        <a href="https://form.respondi.app/i6Erssez" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Proteger Meus Clientes Agora
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="https://form.respondi.app/i6Erssez" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          Agendar Demonstração
        </a>
      </div>

      <!-- Countdown -->
      <div class="countdown-container">
        <span class="countdown-label">FALTAM:</span>
        <div id="countdown" class="countdown-numbers">
          <span id="days">--</span>d
          <span class="colon">:</span>
          <span id="hours">--</span>h
          <span class="colon">:</span>
          <span id="minutes">--</span>m
          <span class="colon">:</span>
          <span id="seconds">--</span>s
        </div>
      </div>
    </div>

    <!-- Right Side: Mental Health & Product Interface Space (Disruptive) -->
    <div class="hero-visual reveal-right">
      <div class="visual-wrapper">
        <!-- Neural Brain SVG Background -->
        <svg class="neural-network" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#004aad" stop-opacity="0.4" />
              <stop offset="100%" stop-color="#000000" stop-opacity="0" />
            </radialGradient>
          </defs>
          <circle cx="200" cy="200" r="180" fill="url(#glow)" />
          
          <!-- Brain Silhouette overlay -->
          <path d="M200,100 C150,100 120,120 120,170 C120,195 130,210 130,230 C130,260 145,290 180,290 C190,290 195,280 200,280 C205,280 210,290 220,290 C255,290 270,260 270,230 C270,210 280,195 280,170 C280,120 250,100 200,100 Z" stroke="#004aad" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.3" fill="none" />
          
          <!-- Stress waves (Mental Exhaustion Indicator) -->
          <circle cx="200" cy="180" r="40" stroke="#ff3333" stroke-width="1" stroke-dasharray="2 4" class="stress-wave wave-1" />
          <circle cx="200" cy="180" r="70" stroke="#ff3333" stroke-width="0.8" stroke-dasharray="3 6" class="stress-wave wave-2" opacity="0.7" />
          <circle cx="200" cy="180" r="100" stroke="#ff3333" stroke-width="0.5" class="stress-wave wave-3" opacity="0.4" />

          <!-- Active Neural Paths -->
          <path d="M150,150 Q200,120 250,150" stroke="#004aad" stroke-width="2" class="neural-path" />
          <path d="M140,210 Q200,240 260,210" stroke="#004aad" stroke-width="1.5" class="neural-path" />
          <path d="M200,100 L200,280" stroke="#004aad" stroke-width="1" stroke-dasharray="5 5" opacity="0.5" />
          
          <!-- Nodes -->
          <circle cx="150" cy="150" r="5" fill="#ffffff" class="node node-1" />
          <circle cx="250" cy="150" r="5" fill="#2d8cf0" class="node node-2" />
          <circle cx="200" cy="120" r="6" fill="#004aad" class="node node-3" />
          <circle cx="140" cy="210" r="5" fill="#ffffff" class="node node-4" />
          <circle cx="260" cy="210" r="5" fill="#2d8cf0" class="node node-5" />
          <circle cx="200" cy="240" r="6" fill="#ff3333" class="node node-burnout" />
        </svg>

        <!-- System Interface Preview Container (Spot to put screenshots later) -->
        <div class="system-preview-card">
          <div class="preview-header">
            <div class="dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <div class="preview-tab">segurament-analytics.sh</div>
          </div>
          <div class="preview-body">
            <div class="preview-screenshot-container">
              <!-- Screenshot Placeholder slot -->
              <div class="placeholder-content">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--blue-bright)" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
                <span class="system-tag">[IMAGEM DO DASHBOARD DO SISTEMA]</span>
                <span class="system-subtext">Compliance, AEP e Gestão de Riscos Psicossociais</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Dot Grid Pattern -->
  <div class="dot-grid"></div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background-color: var(--black-rich);
    padding-top: 120px;
    padding-bottom: 80px;
    overflow: hidden;
  }

  /* Marquee/Ticker */
  .ticker-wrap {
    position: absolute;
    top: 80px;
    left: 0;
    width: 100%;
    overflow: hidden;
    height: 32px;
    background-color: var(--danger);
    z-index: 10;
    display: flex;
    align-items: center;
  }

  .ticker {
    display: inline-flex;
    white-space: nowrap;
    animation: marquee 25s linear infinite;
  }

  .ticker-item {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--white);
    padding: 0 30px;
    letter-spacing: 0.05em;
  }

  @keyframes marquee {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .urgency-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(220, 38, 38, 0.15);
    border: 1px solid var(--danger);
    border-radius: var(--radius-full);
    padding: 6px 16px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--white);
    margin-bottom: 24px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--danger);
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    color: var(--white);
    margin-bottom: 24px;
    letter-spacing: -0.04em;
  }

  .strike-through {
    text-decoration: line-through;
    color: var(--white-dim);
    text-decoration-color: var(--danger);
    text-decoration-thickness: 3px;
  }

  .hero-highlight {
    display: block;
    color: var(--blue-bright);
    margin-top: 8px;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--white-muted);
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 600px;
  }

  .hero-description strong {
    color: var(--white);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 40px;
  }

  /* Countdown stylings */
  .countdown-container {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    width: 100%;
    padding-top: 24px;
  }

  .countdown-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--white-dim);
  }

  .countdown-numbers {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--white);
  }

  .countdown-numbers span {
    color: var(--blue-bright);
    font-variant-numeric: tabular-nums;
  }

  .colon {
    animation: blink 1s step-end infinite;
    margin: 0 2px;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* Visual Container styling */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .visual-wrapper {
    position: relative;
    width: 100%;
    max-width: 440px;
  }

  .neural-network {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 10px rgba(0, 74, 173, 0.15));
  }

  /* Stress / mental burnout waves */
  .stress-wave {
    transform-origin: center;
    animation: stressPulse 4s infinite linear;
  }

  .wave-2 { animation-delay: 1.3s; }
  .wave-3 { animation-delay: 2.6s; }

  @keyframes stressPulse {
    0% { transform: scale(0.9); opacity: 0.9; }
    50% { opacity: 0.5; }
    100% { transform: scale(1.1); opacity: 0; }
  }

  /* Active nodes & path animations */
  .node {
    animation: nodePulse 2s infinite ease-in-out;
  }

  .node-1 { animation-delay: 0.2s; }
  .node-2 { animation-delay: 0.5s; }
  .node-3 { animation-delay: 0.8s; }
  .node-burnout {
    animation: burnoutPulse 1s infinite alternate;
  }

  @keyframes nodePulse {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; filter: drop-shadow(0 0 4px var(--blue-bright)); }
  }

  @keyframes burnoutPulse {
    0% { transform: scale(1); fill: #ff3333; filter: drop-shadow(0 0 2px #ff3333); }
    100% { transform: scale(1.4); fill: #ff8888; filter: drop-shadow(0 0 8px #ff3333); }
  }

  /* System preview block */
  .system-preview-card {
    position: absolute;
    bottom: -30px;
    right: -20px;
    width: 90%;
    background-color: var(--black-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg), 0 0 30px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }

  .preview-header {
    background-color: rgba(255, 255, 255, 0.03);
    padding: 8px 16px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .preview-header .dots {
    display: flex;
    gap: 6px;
  }

  .preview-header .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .preview-header .dot.red { background-color: #ff5f56; }
  .preview-header .dot.yellow { background-color: #ffbd2e; }
  .preview-header .dot.green { background-color: #27c93f; }

  .preview-tab {
    font-family: monospace;
    font-size: 0.7rem;
    color: var(--white-dim);
    margin-left: 20px;
  }

  .preview-body {
    padding: 16px;
  }

  .preview-screenshot-container {
    background-color: var(--black);
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition-base);
  }

  .preview-screenshot-container:hover {
    border-color: rgba(0, 74, 173, 0.4);
  }

  .placeholder-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    padding: 16px;
  }

  .system-tag {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--white);
    letter-spacing: 0.05em;
  }

  .system-subtext {
    font-size: 0.65rem;
    color: var(--white-muted);
  }

  /* Dot Grid Pattern Background */
  .dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: 1;
    pointer-events: none;
  }

  /* Responsividade */
  @media (max-width: 991px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    
    .hero-visual {
      margin-top: 20px;
    }

    .system-preview-card {
      bottom: -15px;
      right: 0;
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: 150px;
    }

    .ticker-wrap {
      top: 70px;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
    }
  }
</style>

<script>
  // Countdown to 26 May 2026
  const targetDate = new Date('May 26, 2026 00:00:00').getTime();

  function updateCountdown() {
    const now = new Date().getTime();
    const difference = targetDate - now;

    if (difference <= 0) {
      document.getElementById('countdown').innerHTML = "FISCALIZAÇÃO ATIVA";
      return;
    }

    const d = Math.floor(difference / (1000 * 60 * 60 * 24));
    const h = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const m = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
    const s = Math.floor((difference % (1000 * 60)) / 1000);

    const dEl = document.getElementById('days');
    const hEl = document.getElementById('hours');
    const mEl = document.getElementById('minutes');
    const sEl = document.getElementById('seconds');

    if (dEl) dEl.innerText = d.toString().padStart(2, '0');
    if (hEl) hEl.innerText = h.toString().padStart(2, '0');
    if (mEl) mEl.innerText = m.toString().padStart(2, '0');
    if (sEl) sEl.innerText = s.toString().padStart(2, '0');
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
