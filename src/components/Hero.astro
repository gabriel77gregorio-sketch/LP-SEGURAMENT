<section class="hero-section">


  <div class="container hero-container">
    <div class="hero-content reveal">
      <div class="urgency-badge compliance-badge-hero">
        <span class="badge-icon">✓</span>
        <span>Conformidade com a NR-1 garantida</span>
      </div>
      
      <h1 class="hero-title">
        Gere valor para a sua assessoria de SST com <span class="hero-highlight">eficiência e segurança.</span>
      </h1>
      
      <p class="hero-description">
        Simplifique a avaliação de riscos psicossociais. O <strong>SEGURAMENT</strong> é a retaguarda tecnológica que ajuda você a cuidar dos seus clientes sem complicações.
      </p>

      <div class="hero-actions">
        <a href="https://form.respondi.app/i6Erssez" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Proteger Meus Clientes Agora
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="https://form.respondi.app/i6Erssez" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          Acessar Plataforma
        </a>
      </div>


    </div>

    <!-- Right Side: Mental Health & Product Interface Space (Disruptive) -->
    <div class="hero-visual reveal-right">
      <div class="visual-wrapper">
        <!-- Clean Background -->
        <div class="hero-bg-shape"></div>

        <!-- System Interface Preview Container (Spot to put screenshots later) -->
        <div class="system-preview-card">
          <div class="preview-header">
            <div class="dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <div class="preview-tab">segurament-analytics.sh</div>
          </div>
          <div class="preview-body">
            <div class="preview-screenshot-container">
              <img src="/IMAGEM%20DO%20DASHBOARD.jpg" alt="Dashboard do SEGURAMENT" class="system-dashboard-image" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Dot Grid Pattern -->
  <div class="dot-grid"></div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background-color: var(--black-rich);
    padding-top: 120px;
    padding-bottom: 80px;
    overflow: hidden;
  }



  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .compliance-badge-hero {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: var(--radius-full);
    padding: 6px 16px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--success);
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    color: var(--white);
    margin-bottom: 24px;
    letter-spacing: -0.04em;
  }

  .strike-through {
    text-decoration: line-through;
    color: var(--white-dim);
    text-decoration-color: var(--danger);
    text-decoration-thickness: 3px;
  }

  .hero-highlight {
    display: block;
    color: var(--blue-bright);
    margin-top: 8px;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--white-muted);
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 600px;
  }

  .hero-description strong {
    color: var(--white);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 40px;
  }



  /* Visual Container styling */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .visual-wrapper {
    position: relative;
    width: 100%;
    max-width: 440px;
  }

  .hero-bg-shape {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(0,74,173,0.1) 0%, rgba(0,74,173,0) 70%);
    border-radius: 50%;
    z-index: 0;
  }

  /* System preview block */
  .system-preview-card {
    position: absolute;
    bottom: -40px;
    right: -45%;
    width: 145%;
    background-color: var(--black-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg), 0 0 30px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    z-index: 5;
  }

  .preview-header {
    background-color: rgba(255, 255, 255, 0.03);
    padding: 8px 16px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .preview-header .dots {
    display: flex;
    gap: 6px;
  }

  .preview-header .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .preview-header .dot.red { background-color: #ff5f56; }
  .preview-header .dot.yellow { background-color: #ffbd2e; }
  .preview-header .dot.green { background-color: #27c93f; }

  .preview-tab {
    font-family: monospace;
    font-size: 0.7rem;
    color: var(--white-dim);
    margin-left: 20px;
  }

  .preview-body {
    padding: 16px;
  }

  .preview-screenshot-container {
    background-color: var(--black);
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition-base);
  }

  .preview-screenshot-container:hover {
    border-color: rgba(0, 74, 173, 0.4);
  }

  .system-dashboard-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .placeholder-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    padding: 16px;
  }

  .system-tag {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--white);
    letter-spacing: 0.05em;
  }

  .system-subtext {
    font-size: 0.65rem;
    color: var(--white-muted);
  }

  /* Dot Grid Pattern Background */
  .dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: 1;
    pointer-events: none;
  }

  /* Responsividade */
  @media (max-width: 991px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    
    .hero-visual {
      margin-top: 20px;
    }

    .system-preview-card {
      bottom: -15px;
      right: 0;
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: 150px;
    }

    .ticker-wrap {
      top: 70px;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
    }
  }
</style>


